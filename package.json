{
  "name": "pinejs-client-supertest",
  "version": "4.0.0",
  "description": "This module provides the nodejs interface for the pinejs API using supertest.",
  "type": "module",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "default": "./build/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/balena-io-modules/pinejs-client-supertest.git"
  },
  "keywords": [
    "pinejs",
    "pinejs-client",
    "supertest"
  ],
  "author": "Thodoris Greasidis <thodoris@balena.io>",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/balena-io-modules/pinejs-client-supertest/issues"
  },
  "homepage": "https://github.com/balena-io-modules/pinejs-client-supertest#readme",
  "files": [
    "build/"
  ],
  "engines": {
    "node": "^24 || >=26",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "build": "npm run lint && tsc",
    "lint": "balena-lint src",
    "lint-fix": "balena-lint --fix src",
    "test": "npm run build",
    "prepack": "npm run build",
    "prepare": "node -e \"try { (await import('husky')).default() } catch (e) { if (e.code !== 'ERR_MODULE_NOT_FOUND') throw e }\" --input-type module"
  },
  "devDependencies": {
    "@balena/lint": "^9.4.6",
    "@types/chai": "^4.3.20",
    "@types/chai-as-promised": "^8.0.0",
    "chai": "^4.5.0",
    "chai-as-promised": "^8.0.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "@balena/abstract-sql-to-typescript": "^6.0.0",
    "@types/express": "^4.17.25",
    "@types/supertest": "^7.0.0",
    "pinejs-client-core": "^8.5.29",
    "supertest": "^7.2.2"
  },
  "versionist": {
    "publishedAt": "2026-10-29T04:33:09.572Z"
  }
}
