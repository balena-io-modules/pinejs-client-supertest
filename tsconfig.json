{
	"compilerOptions": {
		"module": "Node20",
		"rootDir": "./src",
		"outDir": "build",
		"noImplicitAny": true,
		"noUnusedParameters": true,
		"noUnusedLocals": true,
		"removeComments": true,
		"sourceMap": true,
		"strictNullChecks": true,
		"target": "es2025",
		"declaration": true,
		"skipLibCheck": true,
		"erasableSyntaxOnly": true,
		"verbatimModuleSyntax": true,
		"rewriteRelativeImportExtensions": true
	},
	"include": [
		"src/*.ts"
	]
}
